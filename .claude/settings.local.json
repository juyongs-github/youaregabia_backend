{
  "permissions": {
    "allow": [
      "Bash(./gradlew dependencies:*)",
      "Bash(curl -s http://localhost:8001/health)",
      "Bash(taskkill /PID 20156 /F)",
      "Bash(netstat -ano)",
      "Bash(powershell -Command \"Stop-Process -Id 20156 -Force -ErrorAction SilentlyContinue; Start-Sleep 1; netstat -ano | Select-String '':8001|:8080''\")",
      "Bash(venv/Scripts/uvicorn main:app --host 0.0.0.0 --port 8001)",
      "Bash(./gradlew bootRun)",
      "Bash(venv/Scripts/pip install:*)"
    ]
  }
}
